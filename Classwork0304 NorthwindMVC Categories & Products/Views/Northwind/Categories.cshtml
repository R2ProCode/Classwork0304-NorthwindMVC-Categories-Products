@using Classwork0304_NorthwindMVC_Categories___Products.Models;
@model CategoriesViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Categories</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row mt-5">
            <h1>Categories</h1>
            <div class="col-md-12">
                <table class="table table-primary table-hover table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Category category in Model.Categories)
                        {
                            <tr>
                                <td>@category.Id</td>
                                <td>
                                    <a href="/Northwind/Products?categoryId=@category.Id&categoryName=@category.Name" class="btn" style="background-color: #d63384; border-color: #d63384; color: #fff;">@category.Name</a>
                                </td>
                                <td>@category.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
